{
  "name": "app-with-service-account",
  "version": "1.0.0",
  "description": "Example app demonstrating how to set up a tailored service account to authenticate against Grafana",
  "scripts": {
    "build": "webpack -c ./.config/webpack/webpack.config.ts --env production",
    "build:prod": "yarn build && mage -v build:linux",
    "dev": "webpack -w -c ./.config/webpack/webpack.config.ts --env development",
    "e2e": "playwright test",
    "test": "jest --watch --onlyChanged",
    "test:ci": "jest --passWithNoTests --maxWorkers 4",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --cache --ignore-path ./.gitignore --ext .js,.jsx,.ts,.tsx .",
    "lint:fix": "npm run lint -- --fix",
    "server": "docker-compose up --build",
    "sign": "npx --yes @grafana/sign-plugin@latest"
  },
  "author": "Grafana",
  "license": "Apache-2.0",
  "devDependencies": {
    "@babel/core": "^7.28.4",
    "@grafana/eslint-config": "^8.2.0",
    "@grafana/eslint-plugin-plugins": "^0.4.6",
    "@grafana/plugin-e2e": "^2.1.12",
    "@grafana/tsconfig": "2.0.0",
    "@grafana/plugin-meta-extractor": "^0.9.1",
    "@playwright/test": "^1.55.0",
    "@stylistic/eslint-plugin-ts": "^4.4.1",
    "@swc/core": "^1.13.5",
    "@swc/helpers": "^0.5.17",
    "@swc/jest": "^0.2.39",
    "@testing-library/jest-dom": "6.8.0",
    "@testing-library/react": "16.3.0",
    "@typescript-eslint/eslint-plugin": "^8.43.0",
    "@typescript-eslint/parser": "^8.43.0",
    "@types/jest": "^30.0.0",
    "@types/lodash": "^4.17.20",
    "@types/node": "^24.4.0",
    "@types/react-router-dom": "^5.3.3",
    "copy-webpack-plugin": "^13.0.1",
    "css-loader": "^7.1.2",
    "eslint": "^9.35.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-deprecation": "^3.0.0",
    "eslint-plugin-jsdoc": "^57.0.8",
    "eslint-webpack-plugin": "^5.0.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "fork-ts-checker-webpack-plugin": "^9.1.0",
    "glob": "^11.0.3",
    "identity-obj-proxy": "3.0.0",
    "jest": "^30.1.3",
    "jest-environment-jsdom": "^30.1.2",
    "prettier": "^3.6.2",
    "raw-loader": "^4.0.2",
    "replace-in-file-webpack-plugin": "^1.0.6",
    "sass": "1.92.1",
    "sass-loader": "16.0.5",
    "style-loader": "4.0.0",
    "swc-loader": "^0.2.3",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "5.9.2",
    "webpack": "^5.101.3",
    "webpack-cli": "^6.0.1",
    "webpack-livereload-plugin": "^3.0.2",
    "imports-loader": "^5.0.0",
    "webpack-virtual-modules": "^0.6.2"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@emotion/css": "11.13.5",
    "@grafana/data": "^12.1.0",
    "@grafana/runtime": "^12.1.0",
    "@grafana/ui": "^12.0.0",
    "@grafana/experimental": "2.1.6",
    "@grafana/schema": "12.1.0",
    "react": "~19.1.1",
    "react-dom": "~19.1.1",
    "react-router-dom": "5.3.4",
    "rxjs": "~7.8.1",
    "tslib": "2.8.1"
  },
  "resolutions": {
    "string-width": "^4.2.0",
    "wrap-ansi": "^7.0.0",
    "rxjs": "~7.8.1"
  }
}
